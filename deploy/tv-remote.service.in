[Unit]
Description=Shield TV remote (web app for phones on the home Wi-Fi)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
# Addresses, port and app tiles come from config.json in the working directory.
ExecStart=@DIR@/.venv/bin/python server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
